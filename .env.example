# Application
APP_NAME=TF Bank Demo
APP_ENV=demo
PUBLIC_BASE_URL=
DATA_DIR=/data
MAX_UPLOAD_MB=10

# Runtime behavior
FORCE_DEMO_MODE=false
ALLOW_RUNTIME_CONFIG=false

# AI Guard — Rev 118 live integration
AI_GUARD_ENABLED=true
AI_GUARD_REGION=sg
AI_GUARD_APP_NAME=tfbank-demo
AI_GUARD_API_KEY=

# Vision One server defaults
VISION_ONE_DEFAULT_REGION=sg
VISION_ONE_DEFAULT_API_KEY=

# Base application compatibility
TMV1_REGION=sg
TMV1_APPLICATION_NAME=tfbank-demo
TMV1_API_KEY=
AI_GUARD_FALLBACK=block
AI_GUARD_MASK_PII=true
AI_GUARD_TIMEOUT_SECONDS=8

# LLM
LLM_CHAT_URL=
LLM_API_KEY=
LLM_MODEL=visionone-bank-demo
LLM_REAL_ONLY=true
LLM_TIMEOUT_SECONDS=30

# AI Scanner / TMAS
TMAS_API_KEY=
TMAS_BINARY=/usr/local/bin/tmas
TMAS_ENV_FILE=
AI_SCANNER_RUNTIME_DIR=/tmp/bambank-aiscan
AI_SCANNER_TARGET_BASE_URL=
AI_SCANNER_MAX_SECONDS=300
AI_SCANNER_TARGET_TOKEN=

# File Security
FILE_SECURITY_ENABLED=true
FILE_SECURITY_API_KEY=
FILE_SECURITY_REGION=ap-southeast-1
FILE_SECURITY_PML=true
FILE_SECURITY_DEMO_FALLBACK=false

# Optional File Security Storage
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_PREFIX=incoming/
AWS_REGION=ap-southeast-1
