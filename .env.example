APP_NAME=VisionOne Bank Demo
PUBLIC_BASE_URL=https://bank-demo.example.com
DATA_DIR=/data
MAX_UPLOAD_MB=10

# TrendAI Vision One AI Guard
TMV1_REGION=sg
TMV1_API_KEY=
TMV1_APPLICATION_NAME=visionone-bank-demo
AI_GUARD_ENABLED=true
AI_GUARD_FALLBACK=block
AI_GUARD_MASK_PII=true
AI_GUARD_TIMEOUT_SECONDS=8
FORCE_DEMO_MODE=false
ALLOW_RUNTIME_CONFIG=false

# Optional external OpenAI-compatible model
LLM_CHAT_URL=
LLM_API_KEY=
LLM_MODEL=visionone-bank-demo
LLM_TIMEOUT_SECONDS=30

# TrendAI Vision One File Security SDK
FILE_SECURITY_ENABLED=true
FILE_SECURITY_API_KEY=
FILE_SECURITY_REGION=ap-southeast-1
FILE_SECURITY_PML=true
FILE_SECURITY_DEMO_FALLBACK=true

# Optional File Security Storage / monitored S3 bucket
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_PREFIX=incoming/
AWS_REGION=ap-southeast-1

# Optional bearer token required by the two AI Scanner target endpoints
AI_SCANNER_TARGET_TOKEN=
